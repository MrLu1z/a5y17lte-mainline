# gen_init_cpio list (paths relative to the project root; build-mainline.sh
# rewrites them to absolute paths)
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/tty0 0600 0 0 c 4 0
nod /dev/null 0666 0 0 c 1 3
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /tmp 1777 0 0
dir /root 0700 0 0
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /etc 0755 0 0
dir /etc/dropbear 0700 0 0
file /init mainline/rootfs/init 0755 0 0
file /bin/busybox upstream/userspace/out/busybox 0755 0 0
file /sbin/a5-diag build/a5-diag 0755 0 0
file /sbin/dropbearmulti upstream/userspace/out/dropbearmulti 0755 0 0
slink /sbin/dropbear dropbearmulti 0777 0 0
slink /sbin/dropbearkey dropbearmulti 0777 0 0
file /etc/passwd mainline/rootfs/etc/passwd 0644 0 0
file /etc/group mainline/rootfs/etc/group 0644 0 0
file /etc/shells mainline/rootfs/etc/shells 0644 0 0
file /etc/profile mainline/rootfs/etc/profile 0644 0 0
file /etc/udhcpd.conf mainline/rootfs/etc/udhcpd.conf 0644 0 0
