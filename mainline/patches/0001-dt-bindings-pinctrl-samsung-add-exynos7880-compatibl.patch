From 8bf0ce3fbc3d8234ab46c8cef591f4debd9ac6a8 Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Mon, 19 Oct 2026 00:35:12 +0300
Subject: [PATCH 1/3] dt-bindings: pinctrl: samsung: add exynos7880 compatibles

Add samsung,exynos7880-pinctrl and samsung,exynos7880-wakeup-eint.
The wake-up interrupt controller is compatible with
samsung,exynos7-wakeup-eint, like the other Exynos7-style SoCs.

Assisted-by: Claude:claude-opus-5-5
---
 .../bindings/pinctrl/samsung,pinctrl-wakeup-interrupt.yaml       | 1 +
 Documentation/devicetree/bindings/pinctrl/samsung,pinctrl.yaml   | 1 +
 2 files changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl-wakeup-interrupt.yaml b/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl-wakeup-interrupt.yaml
index 2b88f25e8..74f43d311 100644
--- a/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl-wakeup-interrupt.yaml
+++ b/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl-wakeup-interrupt.yaml
@@ -39,6 +39,7 @@ properties:
           - enum:
               - samsung,exynos5433-wakeup-eint
               - samsung,exynos7870-wakeup-eint
+              - samsung,exynos7880-wakeup-eint
               - samsung,exynos7885-wakeup-eint
               - samsung,exynos850-wakeup-eint
               - samsung,exynos8890-wakeup-eint
diff --git a/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl.yaml
index 7b006009c..2e94f5a34 100644
--- a/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl.yaml
+++ b/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl.yaml
@@ -51,6 +51,7 @@ properties:
       - samsung,exynos5433-pinctrl
       - samsung,exynos7-pinctrl
       - samsung,exynos7870-pinctrl
+      - samsung,exynos7880-pinctrl
       - samsung,exynos7885-pinctrl
       - samsung,exynos850-pinctrl
       - samsung,exynos8890-pinctrl
