From 3c4c0c86ed6acec82daa421e7dc4917f4afb7296 Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Mon, 19 Oct 2026 00:35:12 +0300
Subject: [PATCH 2/7] pinctrl: samsung: add Exynos7880 support

Exynos7880 uses the same pin bank types as Exynos7870. It differs in an
extra gpa3 bank in the ALIVE controller, an extra gpd5 bank in TOP, and a
CCORE controller (gpm0) where Exynos7870 has MIF. Bank sizes, offsets and
EINT offsets follow the Samsung universal7880 vendor kernel
(drivers/pinctrl/samsung/pinctrl-exynos.c, exynos7880_pin_banks0..7).

Assisted-by: Claude:claude-opus-5-5
---
 .../pinctrl/samsung/pinctrl-exynos-arm64.c    | 138 ++++++++++++++++++
 drivers/pinctrl/samsung/pinctrl-samsung.c     |   2 +
 drivers/pinctrl/samsung/pinctrl-samsung.h     |   1 +
 3 files changed, 141 insertions(+)

diff --git a/drivers/pinctrl/samsung/pinctrl-exynos-arm64.c b/drivers/pinctrl/samsung/pinctrl-exynos-arm64.c
index fe9f92cb0..f425b08f8 100644
--- a/drivers/pinctrl/samsung/pinctrl-exynos-arm64.c
+++ b/drivers/pinctrl/samsung/pinctrl-exynos-arm64.c
@@ -766,6 +766,144 @@ const struct samsung_pinctrl_of_match_data exynos7870_of_data __initconst = {
 	.num_ctrl	= ARRAY_SIZE(exynos7870_pin_ctrl),
 };
 
+/*
+ * Exynos7880 shares the Exynos7870 bank types; the differences are an extra
+ * gpa3 bank in ALIVE, an extra gpd5 bank in TOP and a CCORE controller in
+ * place of MIF (Samsung universal7880 vendor kernel, pinctrl-exynos.c).
+ */
+
+/* pin banks of exynos7880 pin-controller 0 (ALIVE) */
+static const struct samsung_pin_bank_data exynos7880_pin_banks0[] __initconst = {
+	EXYNOS7870_PIN_BANK_EINTN(6, 0x000, "etc0"),
+	EXYNOS7870_PIN_BANK_EINTN(3, 0x020, "etc1"),
+	EXYNOS7870_PIN_BANK_EINTW(8, 0x040, "gpa0", 0x00),
+	EXYNOS7870_PIN_BANK_EINTW(8, 0x060, "gpa1", 0x04),
+	EXYNOS7870_PIN_BANK_EINTW(8, 0x080, "gpa2", 0x08),
+	EXYNOS7870_PIN_BANK_EINTW(5, 0x0a0, "gpa3", 0x0c),
+	EXYNOS7870_PIN_BANK_EINTN(2, 0x0c0, "gpq0"),
+};
+
+/* pin banks of exynos7880 pin-controller 1 (CCORE) */
+static const struct samsung_pin_bank_data exynos7880_pin_banks1[] __initconst = {
+	EXYNOS8895_PIN_BANK_EINTG(2, 0x000, "gpm0", 0x00),
+};
+
+/* pin banks of exynos7880 pin-controller 2 (DISPAUD) */
+static const struct samsung_pin_bank_data exynos7880_pin_banks2[] __initconst = {
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x000, "gpz0", 0x00),
+	EXYNOS8895_PIN_BANK_EINTG(6, 0x020, "gpz1", 0x04),
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x040, "gpz2", 0x08),
+};
+
+/* pin banks of exynos7880 pin-controller 3 (ESE) */
+static const struct samsung_pin_bank_data exynos7880_pin_banks3[] __initconst = {
+	EXYNOS8895_PIN_BANK_EINTG(5, 0x000, "gpc7", 0x00),
+};
+
+/* pin banks of exynos7880 pin-controller 4 (FSYS) */
+static const struct samsung_pin_bank_data exynos7880_pin_banks4[] __initconst = {
+	EXYNOS8895_PIN_BANK_EINTG(3, 0x000, "gpr0", 0x00),
+	EXYNOS8895_PIN_BANK_EINTG(8, 0x020, "gpr1", 0x04),
+	EXYNOS8895_PIN_BANK_EINTG(2, 0x040, "gpr2", 0x08),
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x060, "gpr3", 0x0c),
+	EXYNOS8895_PIN_BANK_EINTG(6, 0x080, "gpr4", 0x10),
+};
+
+/* pin banks of exynos7880 pin-controller 5 (NFC) */
+static const struct samsung_pin_bank_data exynos7880_pin_banks5[] __initconst = {
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x000, "gpc2", 0x00),
+};
+
+/* pin banks of exynos7880 pin-controller 6 (TOP) */
+static const struct samsung_pin_bank_data exynos7880_pin_banks6[] __initconst = {
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x000, "gpb0", 0x00),
+	EXYNOS8895_PIN_BANK_EINTG(3, 0x020, "gpc0", 0x04),
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x040, "gpc1", 0x08),
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x060, "gpc4", 0x0c),
+	EXYNOS8895_PIN_BANK_EINTG(2, 0x080, "gpc5", 0x10),
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x0a0, "gpc6", 0x14),
+	EXYNOS8895_PIN_BANK_EINTG(2, 0x0c0, "gpc8", 0x18),
+	EXYNOS8895_PIN_BANK_EINTG(2, 0x0e0, "gpc9", 0x1c),
+	EXYNOS8895_PIN_BANK_EINTG(7, 0x100, "gpd1", 0x20),
+	EXYNOS8895_PIN_BANK_EINTG(6, 0x120, "gpd2", 0x24),
+	EXYNOS8895_PIN_BANK_EINTG(8, 0x140, "gpd3", 0x28),
+	EXYNOS8895_PIN_BANK_EINTG(7, 0x160, "gpd4", 0x2c),
+	EXYNOS8895_PIN_BANK_EINTG(5, 0x180, "gpd5", 0x30),
+	EXYNOS8895_PIN_BANK_EINTG(3, 0x1a0, "gpe0", 0x34),
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x1c0, "gpf0", 0x38),
+	EXYNOS8895_PIN_BANK_EINTG(2, 0x1e0, "gpf1", 0x3c),
+	EXYNOS8895_PIN_BANK_EINTG(2, 0x200, "gpf2", 0x40),
+	EXYNOS8895_PIN_BANK_EINTG(4, 0x220, "gpf3", 0x44),
+	EXYNOS8895_PIN_BANK_EINTG(5, 0x240, "gpf4", 0x48),
+};
+
+/* pin banks of exynos7880 pin-controller 7 (TOUCH) */
+static const struct samsung_pin_bank_data exynos7880_pin_banks7[] __initconst = {
+	EXYNOS8895_PIN_BANK_EINTG(3, 0x000, "gpc3", 0x00),
+};
+
+static const struct samsung_pin_ctrl exynos7880_pin_ctrl[] __initconst = {
+	{
+		/* pin-controller instance 0 Alive data */
+		.pin_banks	= exynos7880_pin_banks0,
+		.nr_banks	= ARRAY_SIZE(exynos7880_pin_banks0),
+		.eint_wkup_init = exynos_eint_wkup_init,
+		.suspend	= exynos_pinctrl_suspend,
+		.resume		= exynos_pinctrl_resume,
+	}, {
+		/* pin-controller instance 1 CCORE data */
+		.pin_banks	= exynos7880_pin_banks1,
+		.nr_banks	= ARRAY_SIZE(exynos7880_pin_banks1),
+		.eint_gpio_init = exynos_eint_gpio_init,
+		.suspend	= exynos_pinctrl_suspend,
+		.resume		= exynos_pinctrl_resume,
+	}, {
+		/* pin-controller instance 2 DISPAUD data */
+		.pin_banks	= exynos7880_pin_banks2,
+		.nr_banks	= ARRAY_SIZE(exynos7880_pin_banks2),
+	}, {
+		/* pin-controller instance 3 ESE data */
+		.pin_banks	= exynos7880_pin_banks3,
+		.nr_banks	= ARRAY_SIZE(exynos7880_pin_banks3),
+		.eint_gpio_init = exynos_eint_gpio_init,
+		.suspend	= exynos_pinctrl_suspend,
+		.resume		= exynos_pinctrl_resume,
+	}, {
+		/* pin-controller instance 4 FSYS data */
+		.pin_banks	= exynos7880_pin_banks4,
+		.nr_banks	= ARRAY_SIZE(exynos7880_pin_banks4),
+		.eint_gpio_init = exynos_eint_gpio_init,
+		.suspend	= exynos_pinctrl_suspend,
+		.resume		= exynos_pinctrl_resume,
+	}, {
+		/* pin-controller instance 5 NFC data */
+		.pin_banks	= exynos7880_pin_banks5,
+		.nr_banks	= ARRAY_SIZE(exynos7880_pin_banks5),
+		.eint_gpio_init = exynos_eint_gpio_init,
+		.suspend	= exynos_pinctrl_suspend,
+		.resume		= exynos_pinctrl_resume,
+	}, {
+		/* pin-controller instance 6 TOP data */
+		.pin_banks	= exynos7880_pin_banks6,
+		.nr_banks	= ARRAY_SIZE(exynos7880_pin_banks6),
+		.eint_gpio_init = exynos_eint_gpio_init,
+		.suspend	= exynos_pinctrl_suspend,
+		.resume		= exynos_pinctrl_resume,
+	}, {
+		/* pin-controller instance 7 TOUCH data */
+		.pin_banks	= exynos7880_pin_banks7,
+		.nr_banks	= ARRAY_SIZE(exynos7880_pin_banks7),
+		.eint_gpio_init = exynos_eint_gpio_init,
+		.suspend	= exynos_pinctrl_suspend,
+		.resume		= exynos_pinctrl_resume,
+	},
+};
+
+const struct samsung_pinctrl_of_match_data exynos7880_of_data __initconst = {
+	.ctrl		= exynos7880_pin_ctrl,
+	.num_ctrl	= ARRAY_SIZE(exynos7880_pin_ctrl),
+};
+
 /* pin banks of exynos7885 pin-controller 0 (ALIVE) */
 static const struct samsung_pin_bank_data exynos7885_pin_banks0[] __initconst = {
 	EXYNOS_PIN_BANK_EINTN(3, 0x000, "etc0"),
