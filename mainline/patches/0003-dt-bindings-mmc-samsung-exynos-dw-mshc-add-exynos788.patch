From 32c6fd880e9a5df0d6f48eb40adf743360eb129d Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Mon, 19 Oct 2026 00:51:05 +0300
Subject: [PATCH 3/7] dt-bindings: mmc: samsung,exynos-dw-mshc: add exynos7880

The Exynos7880 DW-MSHC with SMU is the same block as on Exynos7870: same
register map, interrupt and clocking in the Samsung vendor kernel, which
drives both with the same driver and settings. Add an exynos7880
compatible with exynos7870-dw-mshc-smu as fallback.

Assisted-by: Claude:claude-opus-5-5
---
 .../devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml        | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml b/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml
index 27c4060f2..b87ea27bd 100644
--- a/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml
+++ b/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml
@@ -34,6 +34,9 @@ properties:
               - samsung,exynos8890-dw-mshc-smu
               - samsung,exynos8895-dw-mshc-smu
           - const: samsung,exynos7-dw-mshc-smu
+      - items:
+          - const: samsung,exynos7880-dw-mshc-smu
+          - const: samsung,exynos7870-dw-mshc-smu
 
   reg:
     maxItems: 1
