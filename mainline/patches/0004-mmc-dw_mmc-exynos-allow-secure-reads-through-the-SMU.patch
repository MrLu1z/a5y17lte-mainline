From 755322f777befb1b4ad4c542868df0c0daa4b688 Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Mon, 19 Oct 2026 01:15:40 +0300
Subject: [PATCH 4/7] mmc: dw_mmc-exynos: allow secure reads through the SMU on
 Exynos7880

On the Galaxy A5 (2017), an Exynos7880 device, every sector read from
the eMMC failed with an I/O error at any bus clock (0.4 to 52 MHz),
while card identification and EXT_CSD reads worked. The SMU sector
policy written by dw_mci_exynos_config_smu() (MPSCTRL0 = 0x71) lacks
SECURE_READ, and the controller's DMA reads are checked as secure
accesses on this SoC. Setting MPSCTRL0 to 0xf1, the bypass value the
Samsung vendor kernel uses (all four access bits plus VALID), makes
reads work at every clock tested.

Set SECURE_READ only for samsung,exynos7880-dw-mshc-smu so the other
SoCs keep their current behaviour.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/mmc/host/dw_mmc-exynos.c | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/drivers/mmc/host/dw_mmc-exynos.c b/drivers/mmc/host/dw_mmc-exynos.c
index 4b76b997d..313f88868 100644
--- a/drivers/mmc/host/dw_mmc-exynos.c
+++ b/drivers/mmc/host/dw_mmc-exynos.c
@@ -44,6 +44,7 @@ struct dw_mci_exynos_priv_data {
 	u32				dqs_delay;
 	u32				saved_dqs_en;
 	u32				saved_strobe_ctrl;
+	bool				smu_secure_read;
 };
 
 static struct dw_mci_exynos_compatible {
@@ -114,10 +115,19 @@ static void dw_mci_exynos_config_smu(struct dw_mci *host)
 		priv->ctrl_type == DW_MCI_TYPE_EXYNOS7870_SMU) {
 		mci_writel(host, MPSBEGIN0, 0);
 		mci_writel(host, MPSEND0, SDMMC_ENDING_SEC_NR_MAX);
-		mci_writel(host, MPSCTRL0, SDMMC_MPSCTRL_SECURE_WRITE_BIT |
+		u32 ctrl = SDMMC_MPSCTRL_SECURE_WRITE_BIT |
 			   SDMMC_MPSCTRL_NON_SECURE_READ_BIT |
 			   SDMMC_MPSCTRL_VALID |
-			   SDMMC_MPSCTRL_NON_SECURE_WRITE_BIT);
+			   SDMMC_MPSCTRL_NON_SECURE_WRITE_BIT;
+
+		/*
+		 * On Exynos7880 the DMA reads are checked as secure accesses:
+		 * without SECURE_READ every sector read is rejected.
+		 */
+		if (priv->smu_secure_read)
+			ctrl |= SDMMC_MPSCTRL_SECURE_READ_BIT;
+
+		mci_writel(host, MPSCTRL0, ctrl);
 	}
 }
 
@@ -389,6 +399,9 @@ static int dw_mci_exynos_parse_dt(struct dw_mci *host)
 			priv->ctrl_type = exynos_compat[idx].ctrl_type;
 	}
 
+	priv->smu_secure_read = of_device_is_compatible(np,
+					"samsung,exynos7880-dw-mshc-smu");
+
 	if (priv->ctrl_type == DW_MCI_TYPE_EXYNOS4412)
 		priv->ciu_div = EXYNOS4412_FIXED_CIU_CLK_DIV - 1;
 	else if (priv->ctrl_type == DW_MCI_TYPE_EXYNOS4210)
-- 
