From 1c8fa4c4c527c522ffb178f6c9b157572047434c Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Sun, 18 Oct 2026 23:50:36 +0000
Subject: [PATCH 5/7] dt-bindings: clock: samsung,exynos7870-cmu: add
 exynos7880 CMU_FSYS

The Exynos7880 CMU_FSYS block has the same register layout as the
Exynos7870 one: every register and bit defined for Exynos7870 is at
the same offset in the Samsung vendor kernel, which only adds three
extra gates on Exynos7880. Its inputs come from CMU_CCORE instead of
CMU_MIF. Add an exynos7880 compatible with the exynos7870 one as
fallback.

Assisted-by: Claude:claude-opus-5-5
---
 .../clock/samsung,exynos7870-cmu.yaml         | 20 +++++++++++--------
 1 file changed, 12 insertions(+), 8 deletions(-)

diff --git a/Documentation/devicetree/bindings/clock/samsung,exynos7870-cmu.yaml b/Documentation/devicetree/bindings/clock/samsung,exynos7870-cmu.yaml
index 3c58712f1..4e11ae99e 100644
--- a/Documentation/devicetree/bindings/clock/samsung,exynos7870-cmu.yaml
+++ b/Documentation/devicetree/bindings/clock/samsung,exynos7870-cmu.yaml
@@ -23,14 +23,18 @@ description: |
 
 properties:
   compatible:
-    enum:
-      - samsung,exynos7870-cmu-mif
-      - samsung,exynos7870-cmu-dispaud
-      - samsung,exynos7870-cmu-fsys
-      - samsung,exynos7870-cmu-g3d
-      - samsung,exynos7870-cmu-isp
-      - samsung,exynos7870-cmu-mfcmscl
-      - samsung,exynos7870-cmu-peri
+    oneOf:
+      - enum:
+          - samsung,exynos7870-cmu-mif
+          - samsung,exynos7870-cmu-dispaud
+          - samsung,exynos7870-cmu-fsys
+          - samsung,exynos7870-cmu-g3d
+          - samsung,exynos7870-cmu-isp
+          - samsung,exynos7870-cmu-mfcmscl
+          - samsung,exynos7870-cmu-peri
+      - items:
+          - const: samsung,exynos7880-cmu-fsys
+          - const: samsung,exynos7870-cmu-fsys
 
   clocks:
     minItems: 1
