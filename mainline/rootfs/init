#!/bin/busybox sh
# Galaxy A5 (2017) mainline - M5d: boot Nura (postmarketOS) from SYSTEM.
# PID 1. Sets up the console, runs the hardware checks (M5a, W0), brings up a
# USB gadget (NCM network + ACM serial) with usb0 = 172.16.42.1, then boots
# Nura: SYSTEM read-only (eMMC force_ro stays 1) under a RAM overlay, so
# nothing is written to the eMMC and every change is gone at reboot.
# Hold VOLUME DOWN during the 3 s prompt (or if Nura fails) to stay in this
# rescue image instead, which serves:
#   ssh root@172.16.42.1        (dropbear, no password, USB cable only)
#   telnet 172.16.42.1          (fallback)
#   /dev/ttyACM0 on the PC      (serial shell)
# and finally becomes the key loop (hold Power 3 s -> TWRP).
/bin/busybox mkdir -p /usr/bin /usr/sbin
/bin/busybox --install -s
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /tmp /run /var/run /var/log /root /etc/dropbear /sys/kernel/config /sys/kernel/debug
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config
mount -t debugfs debugfs /sys/kernel/debug
hostname a5y17lte

a5-diag panel
echo 4 > /proc/sys/kernel/printk
stty -echo -icanon 2>/dev/null

echo
echo "========================================="
echo " Galaxy A5 (2017) - mainline Linux M5d"
echo "========================================="
a5-diag info
a5-diag system
a5-diag usb
a5-diag android

# USB device controller: if the PHY/DWC3 failed to probe because a clock was
# off, a5-diag usb has just turned it on; bind the drivers again.
if [ -z "$(ls /sys/class/udc 2>/dev/null)" ]; then
	echo " usb    : no UDC yet, re-binding PHY and DWC3"
	echo 135c0000.phy > /sys/bus/platform/drivers/exynos5_usb3drd_phy/bind 2>/dev/null
	echo 13600000.usb > /sys/bus/platform/drivers/exynos-dwc3/bind 2>/dev/null
	sleep 1
fi
UDC=$(ls /sys/class/udc 2>/dev/null)
UDC=${UDC%%[[:space:]]*}
echo " usb    : UDC = ${UDC:-NONE}"

G=/sys/kernel/config/usb_gadget/a5
if [ -n "$UDC" ]; then
	mkdir -p $G
	echo 0x1d6b > $G/idVendor	# Linux Foundation
	echo 0x0104 > $G/idProduct	# Multifunction Composite Gadget
	echo 0x0200 > $G/bcdUSB
	mkdir -p $G/strings/0x409
	echo "a5y17lte mainline" > $G/strings/0x409/manufacturer
	echo "Galaxy A5 2017 (mainline Linux)" > $G/strings/0x409/product
	echo "a5y17lte-m4" > $G/strings/0x409/serialnumber
	mkdir -p $G/configs/c.1/strings/0x409
	echo "NCM network + ACM serial" > $G/configs/c.1/strings/0x409/configuration
	echo 250 > $G/configs/c.1/MaxPower
	mkdir -p $G/functions/ncm.usb0 $G/functions/acm.GS0
	echo 02:a5:17:00:00:01 > $G/functions/ncm.usb0/dev_addr
	echo 02:a5:17:00:00:02 > $G/functions/ncm.usb0/host_addr
	ln -s $G/functions/ncm.usb0 $G/configs/c.1/
	ln -s $G/functions/acm.GS0 $G/configs/c.1/
	echo "$UDC" > $G/UDC && echo " usb    : gadget bound (NCM + ACM)"
fi

# The USB D+/D- lines go through the S2MU004 MUIC; make sure it routes them to
# the SoC (a5-diag returns 10 if it had to change the switch), then re-attach.
a5-diag muic
if [ $? -eq 10 ] && [ -n "$UDC" ]; then
	echo "" > $G/UDC; sleep 1; echo "$UDC" > $G/UDC
	echo " usb    : gadget re-attached after MUIC switch"
fi
sleep 2
a5-diag usbregs

# Nura (postmarketOS) on SYSTEM: ext4 read-only + tmpfs overlay -> switch_root.
# Returns only if something is missing; then the rescue services below start.
boot_nura() {
	local ue dev ro=/nura/ro rw=/nura/rw n=/newroot
	ue=$(grep -l '^PARTNAME=SYSTEM$' /sys/class/block/mmcblk0p*/uevent 2>/dev/null)
	ue=${ue%/uevent}
	dev=/dev/${ue##*/}
	[ -b "$dev" ] || { echo " nura   : no SYSTEM partition"; return; }
	[ "$(cat /sys/block/mmcblk0/force_ro)" = 1 ] || { echo " nura   : eMMC not read-only, not booting"; return; }
	mkdir -p $ro $rw $n
	mount -t ext4 -o ro,noload "$dev" $ro || { echo " nura   : mounting $dev failed"; return; }
	if [ ! -x $ro/sbin/init ] || ! grep -q '^ID=' $ro/usr/lib/os-release 2>/dev/null; then
		echo " nura   : $dev has no /sbin/init or os-release"; umount $ro; return
	fi
	echo " nura   : $dev $(grep '^PRETTY_NAME=' $ro/usr/lib/os-release), read-only"
	mount -t tmpfs -o mode=0755,size=50% overlay-rw $rw
	mkdir -p $rw/upper $rw/work
	if ! mount -t overlay overlay -o lowerdir=$ro,upperdir=$rw/upper,workdir=$rw/work $n; then
		echo " nura   : overlay failed"; umount $rw $ro; return
	fi
	# M5d settings, in the RAM layer only: our usb0 address stays (not NM's),
	# and unudhcpd answers as 172.16.42.1 (its OpenRC default is 172.16.41.1)
	mkdir -p $n/etc/NetworkManager/conf.d $n/etc/conf.d
	printf '[keyfile]\nunmanaged-devices=interface-name:usb0\n' \
		> $n/etc/NetworkManager/conf.d/90-a5y17lte-usb0.conf
	echo 'UNUDHCPD_SERVER="172.16.42.1"' > $n/etc/conf.d/unudhcpd.usb0
	# keep both layers visible in Nura, for inspection
	mkdir -p $n/mnt/system-ro $n/mnt/overlay-rw
	mount --move $ro $n/mnt/system-ro
	mount --move $rw $n/mnt/overlay-rw
	umount /tmp
	mount --move /dev $n/dev	# with /dev/pts
	mount --move /proc $n/proc
	mount --move /sys $n/sys	# with configfs (the gadget) and debugfs
	echo " nura   : switch_root -> /sbin/init (OpenRC)"
	exec switch_root $n /sbin/init
}

if ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up 2>/dev/null; then
	echo " net    : usb0 172.16.42.1"
else
	echo " net    : usb0 missing"
fi
echo
echo " Hold VOLUME DOWN now to stay in the rescue image..."
if a5-diag held 3000; then
	echo " rescue : Volume Down held"
else
	boot_nura
	echo " rescue : Nura did not start"
fi

if ifconfig usb0 2>/dev/null | grep -q 'inet addr:172.16.42.1'; then
	touch /tmp/udhcpd.leases
	udhcpd /etc/udhcpd.conf
	dropbear -R -B -p 22 -P /var/run/dropbear.pid 2>/tmp/dropbear.log
	telnetd -l /bin/sh -p 23
	echo " net    : usb0 172.16.42.1 (PC gets 172.16.42.2 by DHCP)"
	echo " net    : ssh root@172.16.42.1   (no password)"
	echo " net    : telnet 172.16.42.1     (fallback)"
else
	echo " net    : usb0 missing"
fi

# serial shell on the ACM port, respawned
if [ -e /dev/ttyGS0 ]; then
	( while true; do setsid -c sh -l </dev/ttyGS0 >/dev/ttyGS0 2>&1; sleep 1; done ) &
	echo " serial : shell on the PC's /dev/ttyACM0"
fi

echo
echo " Hold POWER for 3 s to reboot into TWRP."
echo
exec a5-diag keys
