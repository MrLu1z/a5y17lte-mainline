From 3265368f1003aaaa96d362296bae724d4c1bfca1 Mon Sep 17 00:00:00 2001
From: Jimmy <fakeandroit@gmail.com>
Date: Sun, 18 Oct 2026 02:40:36 +0300
Subject: [PATCH 2/2] board: samsung: a5y17lte: push frames to command-mode
 panel, timed PMU reset

On hardware the step 1 image left the S-Boot logo on screen: the panel
is MIPI command mode (psr_mode = <2>) and only refreshes on a DECON
trigger. Switch DECON to software trigger, fire one frame after every
printk line, and reboot via PMU SWRESET (0x106B0400) after 30 s so a
self-reboot proves the code ran even if nothing is visible.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PCgURnyLYz6KYCEcLn4Tp2
---
 board/samsung/board-a5y17lte.c | 75 +++++++++++++++++++++++++++++++---
 include/soc/exynos7880.h       | 21 ++++++++++
 2 files changed, 90 insertions(+), 6 deletions(-)

diff --git a/board/samsung/board-a5y17lte.c b/board/samsung/board-a5y17lte.c
index b310ca1..8d06fcd 100644
--- a/board/samsung/board-a5y17lte.c
+++ b/board/samsung/board-a5y17lte.c
@@ -18,6 +18,7 @@
 #include <drivers/framework.h>
 #include <lib/simplefb.h>
 #include <lib/debug.h>
+#include <lib/console.h>
 #include <soc/exynos7880.h>
 
 #define A5Y17LTE_FB_BASE	0x67000000
@@ -40,10 +41,43 @@ static void print_reg64(const char *name, uint64_t v)
 	       (unsigned int)(v >> 32), (unsigned int)(v & 0xffffffff));
 }
 
+static inline void wr32(uintptr_t addr, uint32_t v)
+{
+	*(volatile uint32_t *)addr = v;
+}
+
+static uint64_t timer_freq(void)
+{
+	uint64_t f = READ_SYSREG(CNTFRQ_EL0);
+	return f ? f : 26000000;	/* dtsi: arm,armv8-timer 26 MHz */
+}
+
+static void delay_ms(uint64_t ms)
+{
+	uint64_t start = READ_SYSREG(CNTPCT_EL0);
+	uint64_t ticks = timer_freq() / 1000 * ms;
+
+	while (READ_SYSREG(CNTPCT_EL0) - start < ticks)
+		;
+}
+
+/*
+ * Push the framebuffer to the command-mode panel: one software-
+ * triggered frame. Without this the panel keeps showing the S-Boot
+ * logo from its own memory (step 1 hardware result, 2026-10-18).
+ */
+static void decon_kick(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	wr32(DECON_F_BASE + HW_SW_TRIG_CONTROL, DECON_SW_TRIG_IDLE);
+	wr32(DECON_F_BASE + HW_SW_TRIG_CONTROL, DECON_SW_TRIG_FIRE);
+	delay_ms(20);	/* one 60 Hz frame is ~16.7 ms */
+}
+
 int a5y17lte_init(void)
 {
-	/* Allow framebuffer to be written to */
-	*(volatile int*) (DECON_F_BASE + HW_SW_TRIG_CONTROL) = 0x1281;
+	/* Switch DECON to software trigger so we decide when frames go out */
+	wr32(DECON_F_BASE + HW_SW_TRIG_CONTROL, DECON_SW_TRIG_IDLE);
 	return 0;
 }
 
@@ -78,10 +112,34 @@ static void draw_colour_bars(void)
 			fb[y * A5Y17LTE_FB_WIDTH + x] = bars[x / bar_w];
 }
 
+/* Runs after the framebuffer console for every printk line */
+static void kick_console_write(int level, const char *prefix, const char *msg)
+{
+	(void)level; (void)prefix; (void)msg;
+	decon_kick();
+}
+
+static const struct console kick_console = {
+	.write = kick_console_write,
+};
+
+#define A5Y17LTE_RESET_AFTER_S	30
+
+static void pmu_reset(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	wr32(PMU_BASE + PMU_SWRESET, 1);
+	for (;;)
+		__asm__ volatile("wfe");
+}
+
 static int a5y17lte_diag(void)
 {
 	uint64_t el = (READ_SYSREG(CurrentEL) >> 2) & 3;
 
+	console_register(&kick_console);
+	decon_kick();	/* show the splash printed before late_init */
+
 	printk(KERN_NOTICE, "=== a5y17lte step 1 diagnostics ===\n");
 	printk(KERN_INFO, "CurrentEL = EL%d\n", (int)el);
 	print_reg64("MIDR_EL1  ", READ_SYSREG(MIDR_EL1));
@@ -104,6 +162,7 @@ static int a5y17lte_diag(void)
 	printk(KERN_INFO, "fb @ 0x%08x %dx%d (bars: R G B W)\n",
 	       A5Y17LTE_FB_BASE, A5Y17LTE_FB_WIDTH, A5Y17LTE_FB_HEIGHT);
 	draw_colour_bars();
+	decon_kick();
 
 	printk(KERN_INFO, "DECON TRIG = 0x%08x\n",
 	       rd32(DECON_F_BASE + HW_SW_TRIG_CONTROL));
@@ -119,12 +178,16 @@ static int a5y17lte_diag(void)
 		       rd32(base + VG_BASE_ADDR_Y(0)));
 	}
 
-	printk(KERN_NOTICE, "=== step 1 complete: halted ===\n");
-	printk(KERN_NOTICE, "Hold Vol Down + Power ~7s to reboot\n");
+	printk(KERN_NOTICE, "=== step 1b complete ===\n");
+	printk(KERN_NOTICE, "Auto reboot in %d s (proof the code ran)\n",
+	       A5Y17LTE_RESET_AFTER_S);
 
-	for (;;)
-		__asm__ volatile("wfe");
+	for (int i = 0; i < A5Y17LTE_RESET_AFTER_S * 10; i++) {
+		decon_kick();
+		delay_ms(80);
+	}
 
+	pmu_reset();
 	return 0;
 }
 #endif
diff --git a/include/soc/exynos7880.h b/include/soc/exynos7880.h
index 8136629..54ddd6f 100644
--- a/include/soc/exynos7880.h
+++ b/include/soc/exynos7880.h
@@ -15,6 +15,27 @@
 #define DECON_F_BASE		0x14830000
 #define HW_SW_TRIG_CONTROL	0x70	/* regs-decon.h:92 */
 #define DECON_WIN_CONTROL(w)	(0x130 + ((w) * 0x20))	/* regs-decon.h:177 */
+#define SHADOW_REG_UPDATE_REQ	0x60	/* regs-decon.h:85 */
+
+/* HW_SW_TRIG_CONTROL bits (regs-decon.h:93-99) */
+#define TRIG_AUTO_MASK_TRIG	(1 << 12)
+#define TRIG_SW_TRIG		(1 << 8)
+#define TRIG_HW_TRIG_MASK	(1 << 5)
+#define TRIG_HW_TRIG_EN		(1 << 4)
+
+/*
+ * a5y17lte panel is MIPI command mode with hardware (TE) trigger
+ * (exynos7880.dtsi decon_f: psr_mode = <2>, trig_mode = <0>), so the
+ * panel only refreshes when DECON is triggered. We use software
+ * trigger: one frame per kick.
+ */
+#define DECON_SW_TRIG_IDLE	(TRIG_AUTO_MASK_TRIG)
+#define DECON_SW_TRIG_FIRE	(TRIG_AUTO_MASK_TRIG | TRIG_SW_TRIG)
+
+/* PMU (dtsi: system-controller@106B0000); software reset at +0x400
+ * (S5E7880-pmusfr.h:161, exynos-reboot.c:72,299: write 1) */
+#define PMU_BASE		0x106B0000
+#define PMU_SWRESET		0x400
 
 /* Display DMA channels (dtsi: idma_g0..g2, idma_vg0..) */
 #define IDMA_G0_BASE		0x14821000
-- 
2.43.0

