# Reference: <https://postmarketos.org/devicepkg>
maintainer="Jimmy <fakeandroit@gmail.com>"
pkgname=device-samsung-a5y17lte
pkgdesc="Samsung Galaxy A5 (2017)"
pkgver=3
pkgrel=0
url="https://github.com/android-a5y7lte/xnu-a5y17lte"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-exynos7880
	postmarketos-base
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	90-a5y17lte-usb0.conf
	unudhcpd.usb0.confd
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/90-a5y17lte-usb0.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/90-a5y17lte-usb0.conf
	install -Dm644 "$srcdir"/unudhcpd.usb0.confd \
		"$pkgdir"/etc/conf.d/unudhcpd.usb0
}

sha512sums="
"
